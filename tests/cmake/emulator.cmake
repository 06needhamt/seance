get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(VFW_HOST_ARCH aarch64)
set(CMAKE_CROSSCOMPILING FALSE)
set(VFW_QEMU_I386 "/test/qemu-i386")
set(CMAKE_SYSROOT "${CMAKE_CURRENT_BINARY_DIR}/emulator-test-root")
file(MAKE_DIRECTORY "${CMAKE_SYSROOT}/lib")
file(WRITE "${CMAKE_SYSROOT}/lib/ld-linux.so.2" "")
include("${root}/cmake/emulator.cmake")
if(NOT CMAKE_CROSSCOMPILING_EMULATOR STREQUAL
		"/test/qemu-i386;-L;${CMAKE_SYSROOT}")
	message(FATAL_ERROR "Incorrect automatic emulator: ${CMAKE_CROSSCOMPILING_EMULATOR}")
endif()
set(CMAKE_CROSSCOMPILING_EMULATOR "/custom/emulator;--custom")
include("${root}/cmake/emulator.cmake")
if(NOT CMAKE_CROSSCOMPILING_EMULATOR STREQUAL "/custom/emulator;--custom")
	message(FATAL_ERROR "Explicit emulator was overwritten")
endif()
unset(CMAKE_CROSSCOMPILING_EMULATOR)
unset(CMAKE_CROSSCOMPILING_EMULATOR CACHE)
set(VFW_HOST_ARCH x86_64)
include("${root}/cmake/emulator.cmake")
if(CMAKE_CROSSCOMPILING_EMULATOR)
	message(FATAL_ERROR "Native x86 host should not select an emulator")
endif()
file(REMOVE_RECURSE "${CMAKE_SYSROOT}")
